# Atlassian Marketplace API Configuration
# Your Atlassian account email (used for Basic Auth)
ATLASSIAN_EMAIL=your_email@example.com

# Your Atlassian API token
# Get it from: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=your_api_token_here

# Your Developer/Space ID from Atlassian Developer account
ATLASSIAN_DEVELOPER_ID=your_developer_id_here

# Optional: Specific app keys to validate (comma-separated)
# If not set, will validate all apps in your account
APP_KEYS=

# Partner cut percentage for Table Grid Next Generation
PARTNER_CUT_PERCENTAGE=20
